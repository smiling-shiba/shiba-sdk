{
  "name": "@smiling-shiba/sdk",
  "version": "0.1.0",
  "description": "Helpers for writing a Smiling Shiba policy (a game's rules as code): definePolicy, kind, hook, fn, t.",
  "license": "MIT",
  "homepage": "https://github.com/smiling-shiba/shiba-sdk",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/smiling-shiba/shiba-sdk.git"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/fix-dts-extensions.ts",
    "prepublishOnly": "npm run build",
    "lint": "oxlint",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "toy:contract": "node scripts/emit-toy-contract.ts"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
